# Inert names only. `bin/local-stack init` generates distinct local values in
# deploy/local/.local-stack-credentials.env; never copy these labels into a
# running profile.
SECRETS_CIPHER=replace-locally-not-a-secret
SECRETS_COOKIE=replace-locally-not-a-secret
SECRETS_PAGINATION=replace-locally-not-a-secret
SPICEDB_GRPC_PRESHARED_KEY=replace-locally-not-a-secret
